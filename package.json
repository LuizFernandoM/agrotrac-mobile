    "expo-file-system": "~58.0.13",
    "expo-image-picker": "~58.0.10",
    "expo-sqlite": "~58.0.17",
    "react": "19.3.0",
    "react-native": "0.88.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
